# ── Servidor ───────────────────────────────────────────────
PORT=4000
NODE_ENV=development
LOG_LEVEL=info
# Orígenes permitidos por CORS, separados por comas (solo afecta a la web; la app nativa no usa CORS)
CORS_ORIGINS=http://localhost:8081

# ── Supabase ───────────────────────────────────────────────
# Project Settings → API. Con `supabase start` salen en la consola.
SUPABASE_URL=http://127.0.0.1:54321
# Clave pública (anon/publishable): la API la usa con el JWT del usuario, así aplica RLS
SUPABASE_ANON_KEY=
# Clave service_role: SOLO backend. Se usa en el procesado y en el borrado de cuenta
SUPABASE_SERVICE_ROLE_KEY=
# Opcional. Solo si tu proyecto firma los JWT con el secreto HS256 heredado.
# Si lo dejas vacío, la API valida los tokens con las claves públicas (JWKS) del proyecto.
SUPABASE_JWT_SECRET=

# ── Storage ────────────────────────────────────────────────
GARMENTS_BUCKET=garments
# Validez de las URLs firmadas de lectura, en segundos
SIGNED_URL_TTL_SECONDS=3600
