# Variables públicas: Expo las incrusta en la app. Nunca pongas aquí claves secretas.
# URL y clave pública (anon/publishable) de Supabase. Con `supabase start` salen en la consola.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# URL de la API. En un móvil físico usa la IP de tu ordenador, no localhost.
EXPO_PUBLIC_API_URL=http://localhost:4000
